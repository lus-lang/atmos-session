local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
local PACKAGES = string.match(ROOT, "^(.*)[/\\][^/\\]*$")
pledge("load", `fs:read=$PACKAGES/*`)
package.path = `$ROOT/?.lus;$PACKAGES/cookie/?.lus;$PACKAGES/atmos-cookie/?.lus;$PACKAGES/web/?.lus;$PACKAGES/atmos-web/?.lus;$(package.path)`

-- The package requires cookie by its atmosphere URL. The tests load the
-- checkout next to this one in its place.
package.preload["https://atmosp.here/2.0/cookie.lus"] = function()
    return require("cookie")
end

local session = require("session")
local web = require("web")
local cookie = require("cookie")

local function cookies_of(res)
    local set = res.headers["set-cookie"]

    if set == nil then
        return {}
    end

    return type(set) == "table" and set or { set }
end

local function sid_of(res)
    for _, line in ipairs(cookies_of(res)) do
        if pair = line:match("^(sid=[^;]*)") then
            return pair, line
        end
    end

    return nil
end

local function make_app(options)
    local app = web.app()
    options = options or {}
    options.secret = options.secret or "test secret"
    app:register(session, options)

    app:post("/login", function(req)
        session.regenerate(req)
        req.session.user = "ada"
        return 204
    end)

    app:get("/me", function(req)
        return { user = req.session.user, visits = req.session.visits }
    end)

    app:post("/visit", function(req)
        req.session.visits = (req.session.visits or 0) + 1
        return { visits = req.session.visits }
    end)

    app:post("/logout", function(req)
        session.destroy(req)
        return 204
    end)

    return app
end

local function new_session_test()
    local app = make_app()
    local res = app:inject({ method = "POST", path = "/login" })
    local pair, line = sid_of(res)
    assert(pair, "a session cookie")
    assert(line:find("HttpOnly", 1, true) and line:find("SameSite=Lax", 1, true))
    assert(line:find("Max-Age=86400", 1, true))
    local me = app:inject({ path = "/me", headers = { Cookie = pair } }):json()
    assert(me.user == "ada")
end

local function untouched_session_sends_nothing_test()
    local app = make_app()
    local res = app:inject({ path = "/me" })
    assert(sid_of(res) == nil)
end

local function counts_across_requests_test()
    local app = make_app()
    local pair = sid_of(app:inject({ method = "POST", path = "/visit" }))
    local res = app:inject({ method = "POST", path = "/visit", headers = { Cookie = pair } })
    assert(res:json().visits == 2)
    assert(sid_of(res) == nil, "no cookie when the identifier is unchanged")
end

local function forged_cookie_test()
    local app = make_app()
    local pair = sid_of(app:inject({ method = "POST", path = "/login" }))
    local forged = pair:gsub("%.[^.]*$", ".AAAA")
    assert(app:inject({ path = "/me", headers = { Cookie = forged } }):json().user == nil)
    local other = make_app({ secret = "other secret" })
    assert(other:inject({ path = "/me", headers = { Cookie = pair } }):json().user == nil)
end

local function regenerate_changes_id_test()
    local app = make_app()
    local first = sid_of(app:inject({ method = "POST", path = "/visit" }))
    local second = sid_of(
        app:inject({ method = "POST", path = "/login", headers = { Cookie = first } })
    )
    assert(second and second ~= first)
    assert(app:inject({ path = "/me", headers = { Cookie = second } }):json().visits == 1)
    assert(
        app:inject({ path = "/me", headers = { Cookie = first } }):json().visits == nil,
        "old id is gone"
    )
end

local function destroy_test()
    local app = make_app()
    local pair = sid_of(app:inject({ method = "POST", path = "/login" }))
    local res = app:inject({ method = "POST", path = "/logout", headers = { Cookie = pair } })
    local _, line = sid_of(res)
    assert(line:find("Max-Age=0", 1, true))
    assert(app:inject({ path = "/me", headers = { Cookie = pair } }):json().user == nil)
end

local function rolling_test()
    local app = make_app({ rolling = true })
    local pair = sid_of(app:inject({ method = "POST", path = "/visit" }))
    assert(sid_of(app:inject({ path = "/me", headers = { Cookie = pair } })) == pair)
end

local function with_app_cookie_test()
    local app = web.app()
    app:register(cookie)
    app:register(session, { secret = "s" })

    app:post("/", function(req, reply)
        reply:cookie("theme", "dark")
        req.session.n = 1
        return 204
    end)

    local set = cookies_of(app:inject({ method = "POST", path = "/" }))
    assert(#set == 2)
    assert(set[1]:find("^theme=dark"))
    assert(set[2]:find("^sid="))
end

local function memory_store_test()
    local now = 1000

    local store = session.memory({
        max = 2,
        clock = function()
            return now
        end,
    })

    store:set("a", { v = 1 }, 10)
    store:set("b", { v = 2 }, 10)
    now = 1001
    store:set("c", { v = 3 }, 10)
    assert(store:get("a") == nil, "the oldest entry is evicted")
    assert(store:get("c").v == 3)
    now = 1020
    assert(store:get("b") == nil, "expired")
end

local function secret_required_test()
    local ok, err = catch web.app():register(session, {})
    assert(not ok and err:find("secret option is required", 1, true))
end

local function over_the_wire_test()
    pledge("network")
    local app = web.app()
    app:register(cookie)
    app:register(session, { secret = "s" })

    app:post("/", function(req, reply)
        reply:cookie("theme", "dark")
        req.session.n = 1
        return 204
    end)

    local server = network.tcp.bind("127.0.0.1", 0)
    local _, port = server:getsockname()

    local serving = coroutine.detach(coroutine.create(function()
        app:listen(server)
    end))

    local sock <close> = network.tcp.connect("127.0.0.1", port)
    sock:send("POST / HTTP/1.1\r\nHost: l\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    local response = vector.tostring(sock:receive("*a"))
    coroutine.close(serving)
    server:close()
    assert(response:find("\r\nSet-Cookie: theme=dark; Path=/\r\n", 1, true))
    assert(response:find("\r\nSet-Cookie: sid=", 1, true))
end
